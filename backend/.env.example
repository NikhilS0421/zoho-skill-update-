ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
RESEND_API_KEY=
ADMIN_EMAIL=
PORT=9000
# Comma-separated allowed frontend origins, e.g. https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000
# Set to the verified reverse proxy hop count for your deployment, if applicable.
# TRUST_PROXY_HOPS=1

# Optional extra Zoho Contact email field API names; Email and Secondary_Email are always checked.
# ZOHO_CONTACT_EMAIL_FIELDS=Instructor_Email
